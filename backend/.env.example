# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL on Railway; SQLite used when unset in development)
# For Supabase pooler URLs, keep DATABASE_CONN_MAX_AGE at 0 (default).
DATABASE_URL=postgres://user:password@localhost:5432/incident_management
DATABASE_CONN_MAX_AGE=0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Browser requests use the Next.js same-origin proxy and Django sessions.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional for official invitations)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Frontend URL (for activation links)
FRONTEND_URL=http://localhost:3000
